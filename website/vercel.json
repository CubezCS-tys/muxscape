{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "muxscape.dev" }], "destination": "https://muxscape.com/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.muxscape.dev" }], "destination": "https://muxscape.com/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.muxscape.com" }], "destination": "https://muxscape.com/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    { "source": "/_astro/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
