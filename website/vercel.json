{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/download/Muxscape_0.1.0_x64-setup.exe",
      "destination": "https://github.com/CubezCS-tys/muxscape/releases/download/v0.1.0-alpha.1/Muxscape_0.1.0_x64-setup.exe",
      "permanent": false
    },
    {
      "source": "/download/SHA256SUMS.txt",
      "destination": "https://github.com/CubezCS-tys/muxscape/releases/download/v0.1.0-alpha.1/SHA256SUMS.txt",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "https://github.com/CubezCS-tys/muxscape/releases",
      "permanent": false
    }
  ]
}
