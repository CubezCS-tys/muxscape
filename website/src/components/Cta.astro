---
// Download / GitHub buttons that stay honest: until a public URL exists in
// site.config.ts they render as a non-link "coming soon" state.
import { site } from "../site.config";

interface Props {
  kind: "download" | "github";
  size?: "lg" | "sm";
}
const { kind, size = "lg" } = Astro.props;
const href = kind === "download" ? site.downloadUrl : site.githubUrl;
const label = kind === "download" ? "Download for Windows" : "View on GitHub";
const pending = kind === "download" ? "Windows alpha: coming soon" : "Source on GitHub: opening at alpha";
const pad = size === "lg" ? "px-5 py-3 text-[15px]" : "px-3.5 py-2 text-sm";
const primary = kind === "download";
---
{href ? (
  <a
    href={href}
    class:list={[
      "inline-flex items-center gap-2 rounded-xl font-semibold transition-colors",
      pad,
      primary ? "bg-accent text-on-accent hover:bg-strong" : "bg-raised text-strong hover:bg-line",
    ]}
  >
    {label}
    {primary && <span class="font-medium opacity-70">(alpha)</span>}
  </a>
) : (
  <span
    class:list={[
      "inline-flex cursor-default items-center gap-2 rounded-xl font-semibold",
      pad,
      primary ? "bg-accent/15 text-accent ring-1 ring-accent/30" : "bg-raised text-muted",
    ]}
    aria-disabled="true"
    title={primary ? "No public installer has been published yet." : "The repository is private until the alpha."}
  >
    {pending}
  </span>
)}
