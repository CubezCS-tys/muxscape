---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { site } from "../site.config";
import logo from "../assets/logo.png";
import hero from "../assets/screens/hero.png";
import switcher from "../assets/screens/switcher.png";
import ports from "../assets/screens/ports.png";
import secondServer from "../assets/screens/second-server.png";
import htop from "../assets/screens/htop.png";

const scenes = [
  {
    title: "Twenty windows. One click each.",
    body: "Your existing tmux windows become tabs. Split, resize, rename and close panes with the mouse; every action is a real tmux command, so a plain tmux attach sees the same thing.",
    points: ['<b class="text-strong font-semibold">Drag a divider</b> to resize a split', '<b class="text-strong font-semibold">Double-click a tab</b> to rename the window', '<b class="text-strong font-semibold">Drag a tab out</b> into its own window'],
    img: hero,
    alt: "A tmux session with 22 windows as tabs, the first split into a dev server log and a test run.",
  },
  {
    title: "Find anything, fast.",
    body: "The quick switcher fuzzy-finds every window and session across your servers. Twenty windows stops being a memory test.",
    points: ['<kbd class="font-mono text-strong">Ctrl+Shift+P</kbd> jump to any window or session', '<kbd class="font-mono text-strong">Alt+1…9</kbd> and <kbd class="font-mono text-strong">Ctrl+Tab</kbd> between tabs', '<kbd class="font-mono text-strong">Ctrl+Shift+F</kbd> find text in a pane'],
    img: switcher,
    alt: "The quick switcher filtering windows as you type 're': review, release, trailhead, server, worker, migrate.",
  },
  {
    title: "Full-screen programs look right.",
    body: "Each pane is its own terminal, drawn at exactly the size tmux uses. htop, editors and TUIs render as they would in a local terminal.",
    img: htop,
    alt: "htop running full-screen in one tab of the trailhead session.",
  },
  {
    title: "Your dev server, in your browser.",
    body: "Start a dev server and Muxscape notices the localhost:5173 it prints. One click forwards it over your SSH connection and opens it. The Ports panel shows what's listening, what it is and which pane started it.",
    points: ["Forwards listen on your machine's loopback only", "Pin a forward and it comes back on every connect"],
    img: ports,
    alt: "The Ports panel listing port 5173 as 'Trailhead', started by the server window in ~/trailhead.",
  },
  {
    title: "All your servers, side by side.",
    body: "Each server keeps its own connection and sessions in the sidebar, organised in folders, with a colour per host.",
    img: secondServer,
    alt: "A second server, staging, running htop in a session called ops, with the first server still connected in the sidebar.",
  },
];

const nav = [
  { href: "#features", label: "Features" },
  { href: "#how", label: "How it works" },
  { href: "#faq", label: "FAQ" },
];

const faq: { q: string; a: string[] }[] = [
  {
    q: "What is Muxscape?",
    a: [
      "A desktop SSH client whose terminals are real tmux sessions on your servers. Each tmux window is a tab, each pane is a split you can click, drag and resize. Because the work lives in tmux on the server, it keeps running when you close the app or lose your connection.",
    ],
  },
  {
    q: "How is it different from tmux?",
    a: [
      "It is tmux: Muxscape drives the tmux already on your server through tmux's control mode, so sessions, windows and panes are the real thing. What changes is how you use it: tabs instead of a status bar, mouse-driven splits, renaming by double-click and a quick switcher instead of prefix keys. You can still attach from a plain terminal at any time and see the same session.",
    ],
  },
  {
    q: "How is it different from Termius?",
    a: [
      "Termius is a general-purpose SSH client. Muxscape is narrower: it is built around persistent tmux workspaces, so the thing you reconnect to is your running work (every window and pane), not a fresh shell. It has no account and no cloud sync; hosts and settings stay on your machine.",
    ],
  },
  {
    q: "Does it require tmux to be installed?",
    a: [
      "On the server, yes, for persistent workspaces. Muxscape is tested against tmux 3.3 and 3.4. On a server without tmux you still get a normal shell, but it ends when the connection does.",
      "Nothing needs to be installed on your own computer besides Muxscape, and nothing extra is installed on the server.",
    ],
  },
  {
    q: "Do my processes survive disconnection?",
    a: [
      "Yes. They run inside tmux on the server, so closing Muxscape, losing Wi-Fi or restarting your laptop doesn't stop them. When the connection drops, Muxscape reconnects by itself and rebuilds your tabs and panes from what tmux reports.",
    ],
  },
  {
    q: "Does it work with existing tmux sessions?",
    a: [
      "Yes. Sessions you already have show up in the sidebar; open one and its windows become tabs. Changes made from another tmux client (a plain ssh + tmux attach, another laptop) appear immediately, because tmux stays the source of truth.",
    ],
  },
  {
    q: "Does it support Windows, Linux and macOS?",
    a: [
      "The first alpha is for Windows (x64). That is the build we use and test day to day.",
      "Muxscape is built with Tauri, so Linux and macOS builds are possible, but they haven't been tested yet and there are no packages for them. They will be announced when they are.",
    ],
  },
  {
    q: "Is it free and open source?",
    a: [
      "It is intended to be free and open source under the MIT licence. The source code will be published on GitHub soon.",
    ],
  },
];
---
<Base>
  <!-- Navigation -->
  <header class="sticky top-0 z-40 border-b border-white/5 bg-ink/80 backdrop-blur-md">
    <nav class="mx-auto flex max-w-6xl items-center gap-6 px-4 py-3 sm:px-6" aria-label="Main">
      <a href="#top" class="flex items-center gap-2.5 font-bold text-strong">
        <Image src={logo} alt="" width={28} height={28} class="rounded-md" />
        Muxscape
        <span class="rounded-full bg-raised px-2 py-0.5 text-[11px] font-semibold text-muted">alpha</span>
      </a>
      <ul class="ml-auto hidden items-center gap-6 text-sm text-muted md:flex">
        {nav.map((n) => <li><a href={n.href} class="hover:text-strong">{n.label}</a></li>)}
        <li>
          {site.githubUrl ? <a href={site.githubUrl} class="hover:text-strong">GitHub</a> : <span class="cursor-default text-faint" title="Source code coming soon">GitHub</span>}
        </li>
      </ul>
      <a href="#download" class="ml-auto rounded-lg bg-accent px-3 py-1.5 text-sm font-semibold text-on-accent hover:bg-strong md:ml-0">Download</a>
    </nav>
  </header>

  <main id="main">
    <!-- Opening shot -->
    <section id="top" class="relative isolate overflow-hidden">
      <div class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 sm:pt-24">
        <p class="text-sm font-semibold text-accent">{site.tagline}</p>
        <h1 class="mt-4 max-w-3xl text-[2.6rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-strong sm:text-6xl">
          Your servers.<br />Your terminals.<br />One workspace.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{site.description}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Cta kind="download" />
          <Cta kind="github" />
        </div>
        <p class="mt-4 text-sm text-faint">Free. Windows alpha. Works with the SSH and tmux your servers already have.</p>
      </div>

      <div class="mx-auto mt-14 max-w-6xl px-4 sm:px-6">
        <div class="rise">
          <figure class="window">
            <Image src={hero} alt="Muxscape connected to two servers. A tmux session called trailhead has 22 windows shown as tabs; the first is split into two panes, a Node dev server logging requests on the left and a passing test run on the right." widths={[720, 1440, 2160, 2880]} sizes="(min-width: 1152px) 1104px, 100vw" loading="eager" />
          </figure>
        </div>
        <p class="mt-3 text-center text-xs text-faint">A real session: 22 tmux windows on one server, a second server below it.</p>
      </div>
    </section>

    <!-- The five-second version -->
    <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6" aria-label="In short">
      <dl class="grid gap-px overflow-hidden rounded-2xl bg-white/5 sm:grid-cols-3">
        <div class="bg-ink p-6">
          <dt class="font-bold text-strong">Tabs are tmux windows</dt>
          <dd class="mt-2 text-sm leading-relaxed text-muted">Click window 17 instead of remembering it. Split, drag, rename, close: each one is a real tmux command.</dd>
        </div>
        <div class="bg-ink p-6">
          <dt class="font-bold text-strong">Nothing stops when you leave</dt>
          <dd class="mt-2 text-sm leading-relaxed text-muted">Close the app or lose Wi-Fi. Your builds, servers and agents keep running on the server.</dd>
        </div>
        <div class="bg-ink p-6">
          <dt class="font-bold text-strong">Come back to exactly that</dt>
          <dd class="mt-2 text-sm leading-relaxed text-muted">Muxscape reconnects and rebuilds every tab and pane from what tmux reports.</dd>
        </div>
      </dl>
    </section>

    <!-- Scenes: one pinned screen, the story scrolls past it -->
    <section id="features" class="mx-auto mt-28 max-w-6xl px-4 sm:px-6">
      <h2 class="max-w-2xl text-3xl font-extrabold tracking-[-0.02em] text-strong sm:text-4xl">Everything tmux does, without the keyboard gymnastics.</h2>
      <div class="mt-12 lg:mt-4 lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,9fr)] lg:gap-14" data-scenes>
        <ol class="space-y-16 lg:space-y-0">
          {scenes.map((sc, i) => (
            <li class="scene-cap lg:flex lg:min-h-[70vh] lg:items-center" data-scene={i}>
              <div>
                <h3 class="text-2xl font-bold text-strong">{sc.title}</h3>
                <p class="mt-3 leading-relaxed text-muted">{sc.body}</p>
                {sc.points && (
                  <ul class="mt-5 space-y-2 text-sm text-muted">
                    {sc.points.map((pt) => <li set:html={pt} />)}
                  </ul>
                )}
                <figure class="window mt-6 lg:hidden">
                  <Image src={sc.img} alt={sc.alt} widths={[720, 1440]} sizes="100vw" />
                </figure>
              </div>
            </li>
          ))}
        </ol>
        <div class="hidden lg:block">
          <div class="sticky top-[12vh] h-[76vh]">
            <div class="relative flex h-full items-center">
              <div class="window relative aspect-[16/10] w-full">
                {scenes.map((sc, i) => (
                  <Image src={sc.img} alt={sc.alt} widths={[1440, 2160]} sizes="820px" class:list={["scene-shot", i === 0 && "on"]} data-shot={i} />
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-24 grid gap-x-10 gap-y-12 border-t border-white/5 pt-16 sm:grid-cols-2 lg:grid-cols-3">
        <div>
          <h3 class="font-bold text-strong">Persistent workspaces</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">Remote processes survive SSH disconnections and app restarts. Muxscape reconnects on its own and puts every tab and pane back.</p>
        </div>
        <div>
          <h3 class="font-bold text-strong">SSH host management</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">Saved hosts in folders. Hosts from <code class="font-mono text-[0.9em]">~/.ssh/config</code> appear automatically, including <code class="font-mono text-[0.9em]">Include</code>, <code class="font-mono text-[0.9em]">IdentityFile</code> and <code class="font-mono text-[0.9em]">ProxyJump</code>. Keys, ssh-agent and jump hosts.</p>
        </div>
        <div>
          <h3 class="font-bold text-strong">Careful with secrets</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">Host keys are checked against your OpenSSH <code class="font-mono text-[0.9em]">known_hosts</code>. Saved passwords are optional and encrypted (Argon2id, XChaCha20-Poly1305) behind a master password.</p>
        </div>
        <div>
          <h3 class="font-bold text-strong">Built for long-running work</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">Editors, test watchers and coding agents like Claude Code or Codex keep running in tmux while you're away. Paste a screenshot or drop a file onto a pane and it's uploaded to the server, path typed for you.</p>
        </div>
        <div>
          <h3 class="font-bold text-strong">Links that just work</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">Ctrl+click any URL in a terminal. A <code class="font-mono text-[0.9em]">localhost</code> link on the server is forwarded first, then opened.</p>
        </div>
        <div>
          <h3 class="font-bold text-strong">Easy on the eyes</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">Four themes, six accent colours, adjustable text size and a colour per host so production never looks like staging.</p>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="mt-32 bg-side py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="text-3xl font-extrabold tracking-[-0.02em] text-strong sm:text-4xl">How it works</h2>
        <ol class="mt-12 grid gap-10 md:grid-cols-3">
          <li>
            <span class="text-sm font-bold text-accent">Step 1</span>
            <h3 class="mt-2 text-lg font-bold text-strong">Connect</h3>
            <p class="mt-2 leading-relaxed text-muted">Add an SSH host, or pick one from your existing <code class="font-mono text-[0.9em]">~/.ssh/config</code>.</p>
          </li>
          <li>
            <span class="text-sm font-bold text-accent">Step 2</span>
            <h3 class="mt-2 text-lg font-bold text-strong">Work</h3>
            <p class="mt-2 leading-relaxed text-muted">Open an existing tmux session, or start one. Its windows are tabs, its panes are splits.</p>
          </li>
          <li>
            <span class="text-sm font-bold text-accent">Step 3</span>
            <h3 class="mt-2 text-lg font-bold text-strong">Resume</h3>
            <p class="mt-2 leading-relaxed text-muted">Close Muxscape or drop off the network. Come back later and your workspace is exactly where you left it.</p>
          </li>
        </ol>
        <p class="mt-14 max-w-3xl leading-relaxed text-muted">
          There's nothing proprietary on the server. Muxscape speaks standard SSH and drives the server's own tmux through
          <a class="text-accent underline-offset-4 hover:underline" href="https://github.com/tmux/tmux/wiki/Control-Mode">tmux control mode</a>.
          No background agent, no daemon, no account.
        </p>
      </div>
    </section>

    <!-- Demonstrations -->
    <section id="demos" class="mx-auto mt-28 max-w-6xl px-4 sm:px-6">
      <h2 class="text-3xl font-extrabold tracking-[-0.02em] text-strong sm:text-4xl">In motion</h2>
      <p class="mt-4 max-w-2xl text-muted">Two things that are hard to show in a still. Real recordings of the app against a real server.</p>
      <div class="mt-10 grid gap-16">
        <figure>
          <div class="window">
            <video src="/media/reconnect.mp4" poster="/media/reconnect.jpg" autoplay muted loop playsinline preload="none" width="1600" height="1000" class="block h-auto w-full" aria-label="A build is printing progress in a tmux window. The SSH connection drops, Muxscape shows 'Connection lost, reconnecting', then reconnects; the build kept running the whole time."></video>
          </div>
          <figcaption class="mt-3 text-sm leading-relaxed text-muted"><span class="font-semibold text-strong">The connection drops. The build doesn't.</span> Muxscape notices, reconnects on its own, and the output picks up where the server is now.</figcaption>
        </figure>
        <figure>
          <div class="window">
            <video src="/media/restart.mp4" poster="/media/restart.jpg" autoplay muted loop playsinline preload="none" width="1600" height="1000" class="block h-auto w-full" aria-label="Muxscape is quit while a build runs. A little later it opens again on the same session, and the build has carried on."></video>
          </div>
          <figcaption class="mt-3 text-sm leading-relaxed text-muted"><span class="font-semibold text-strong">Quit the app. Come back later.</span> Your sessions reopen and everything you left running is still running.</figcaption>
        </figure>
      </div>
    </section>

    <!-- Under the hood -->
    <section id="tech" class="mx-auto mt-28 max-w-6xl px-4 sm:px-6">
      <div class="grid gap-12 lg:grid-cols-[2fr_3fr]">
        <div>
          <h2 class="text-3xl font-extrabold tracking-[-0.02em] text-strong sm:text-4xl">Under the hood</h2>
          <p class="mt-5 leading-relaxed text-muted">tmux is the source of truth. Muxscape never keeps its own copy of your sessions: it asks tmux what exists, renders it, and turns every click into a tmux command. That's why another tmux client sees your changes instantly, and why there is nothing to lose when the app closes.</p>
        </div>
        <dl class="grid gap-px overflow-hidden rounded-2xl bg-white/5 sm:grid-cols-2">
          <div class="bg-ink p-5"><dt class="font-bold text-strong">Rust core</dt><dd class="mt-1.5 text-sm text-muted">Connections, sessions, port forwarding and the password vault, with tests that run against real SSH and tmux servers.</dd></div>
          <div class="bg-ink p-5"><dt class="font-bold text-strong">SSH transport</dt><dd class="mt-1.5 text-sm text-muted">The russh library: keys, agent, jump hosts, keepalives, host-key checks against known_hosts.</dd></div>
          <div class="bg-ink p-5"><dt class="font-bold text-strong">tmux control mode</dt><dd class="mt-1.5 text-sm text-muted">One control connection per session streams pane output and layout changes as structured events.</dd></div>
          <div class="bg-ink p-5"><dt class="font-bold text-strong">Tauri desktop shell</dt><dd class="mt-1.5 text-sm text-muted">A small native app using the system webview, not a bundled browser.</dd></div>
          <div class="bg-ink p-5"><dt class="font-bold text-strong">React + xterm.js</dt><dd class="mt-1.5 text-sm text-muted">Every pane is its own xterm.js terminal, sized to tmux's exact cell grid.</dd></div>
          <div class="bg-ink p-5"><dt class="font-bold text-strong">Server-side persistence</dt><dd class="mt-1.5 text-sm text-muted">Your processes live in tmux on the server. The app can come and go.</dd></div>
        </dl>
      </div>
    </section>

    <!-- Download / open source -->
    <section id="download" class="mx-auto mt-28 max-w-6xl px-4 sm:px-6">
      <div class="rounded-3xl bg-surface p-8 sm:p-12">
        <div class="grid gap-10 lg:grid-cols-2">
          <div>
            <h2 class="text-3xl font-extrabold tracking-[-0.02em] text-strong">Try the alpha</h2>
            <p class="mt-4 leading-relaxed text-muted">The first public alpha is for Windows (x64). Expect rough edges; tell us about them. Your servers need SSH and, for persistent workspaces, tmux.</p>
            <div class="mt-7 flex flex-wrap gap-3"><Cta kind="download" /></div>
            {site.downloadUrl && site.downloadSha256 && (
              <p class="mt-4 text-xs leading-relaxed text-muted">
                Version {site.version} alpha for Windows 10/11 (x64){site.downloadSize ? `, ${site.downloadSize}` : ""}.<br />
                SHA-256 <code class="font-mono break-all text-text">{site.downloadSha256}</code>
              </p>
            )}
            <p class="mt-3 text-xs leading-relaxed text-faint">The alpha isn't code-signed yet and is brand new, so warnings are expected. Your browser may say the file "isn't commonly downloaded" or is "suspicious": choose <span class="text-muted">Keep</span> (in Edge, open the download's <span class="text-muted">…</span> menu first). Windows SmartScreen may then say "Windows protected your PC": choose <span class="text-muted">More info</span>, then <span class="text-muted">Run anyway</span>. Compare the SHA-256 above if you want to be sure the file is ours. Signed builds are coming.</p>
          </div>
          <div class="lg:border-l lg:border-white/5 lg:pl-10">
            <h2 class="text-3xl font-extrabold tracking-[-0.02em] text-strong">Open source</h2>
            <p class="mt-4 leading-relaxed text-muted">Muxscape is intended to be free and open source under the MIT licence. The code will be published on GitHub soon, along with the tests that run it against real SSH and tmux servers.</p>
            <div class="mt-7 flex flex-wrap gap-3"><Cta kind="github" /></div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="mx-auto mt-28 max-w-3xl px-4 sm:px-6">
      <h2 class="text-3xl font-extrabold tracking-[-0.02em] text-strong sm:text-4xl">Questions</h2>
      <div class="mt-10 divide-y divide-white/5 border-y border-white/5">
        {faq.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-strong">
              {f.q}
              <span class="text-muted transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="prose-faq mt-3 leading-relaxed text-muted">{f.a.map((p) => <p>{p}</p>)}</div>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="mx-auto mt-28 max-w-6xl border-t border-white/5 px-4 py-10 text-sm text-faint sm:px-6">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <span class="flex items-center gap-2 font-semibold text-muted"><Image src={logo} alt="" width={20} height={20} class="rounded" /> Muxscape</span>
      <span>{site.tagline}</span>
      <span class="sm:ml-auto">Version {site.version} alpha</span>
      <span>MIT licence (planned)</span>
    </div>
  </footer>
  <script>
    // Scenes: switch the pinned screenshot when a caption reaches mid-screen.
    const root = document.querySelector("[data-scenes]");
    if (root) {
      const caps = [...root.querySelectorAll<HTMLElement>("[data-scene]")];
      const shots = [...root.querySelectorAll<HTMLElement>("[data-shot]")];
      const show = (i: string) => {
        caps.forEach((c) => c.classList.toggle("on", c.dataset.scene === i));
        shots.forEach((s) => s.classList.toggle("on", s.dataset.shot === i));
      };
      show("0");
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && show((e.target as HTMLElement).dataset.scene!)),
        { rootMargin: "-45% 0px -45% 0px" },
      );
      caps.forEach((c) => io.observe(c));
    }
  </script>
</Base>
